# FastSAE .env example

# Where to cache/download Hugging Face models and datasets
HF_HOME=/absolute/path/to/huggingface_cache

# Where FastSAE will save checkpoints by default
CHECKPOINT_PATH=./checkpoints

# Enable Weights & Biases logging (true/false)
WANDB_ENABLED=false
WANDB_PROJECT=YOUR_REPO
WANDB_ENTITY=YOUR_ENTITY

# Dataloader performance knobs
SAE_DATALOADER_NUM_WORKERS=8
SAE_DATALOADER_PIN_MEMORY=true
SAE_DATALOADER_PERSISTENT_WORKERS=true

# Select visible GPUs (comma-separated indices)
CUDA_VISIBLE_DEVICES=0

# Optional extras (uncomment to use)
# HF_HUB_CACHE=/absolute/path/to/hf_hub_cache
# TRANSFORMERS_CACHE=/absolute/path/to/transformers_cache
# TORCH_HOME=/absolute/path/to/torch_cache
